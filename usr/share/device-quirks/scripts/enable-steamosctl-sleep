#!/bin/bash

USER=$(id -nu 1000)
SERVICE_NAME="steamosctl-sleep.service"

# Use systemctl --machine to access user's systemd from root
IS_ENABLED=$(systemctl --user --machine="${USER}@.host" is-enabled "$SERVICE_NAME" 2>&1)

case "$IS_ENABLED" in
    enabled)
        echo "Service $SERVICE_NAME already enabled"
        ;;
    disabled|static)
        echo "Enabling $SERVICE_NAME for user $USER (current: $IS_ENABLED)"
        systemctl --user --machine="${USER}@.host" enable "$SERVICE_NAME" 2>&1
        
        # Check if service is already running
        IS_ACTIVE=$(systemctl --user --machine="${USER}@.host" is-active "$SERVICE_NAME" 2>&1)
        if [ "$IS_ACTIVE" != "active" ]; then
            echo "Starting $SERVICE_NAME"
            systemctl --user --machine="${USER}@.host" start "$SERVICE_NAME" 2>&1
        fi
        echo "Done"
        ;;
    masked)
        echo "ERROR: Service $SERVICE_NAME is masked, cannot enable"
        echo "To fix: systemctl --user --machine=\"${USER}@.host\" unmask $SERVICE_NAME"
        exit 1
        ;;
    *)
        echo "ERROR: Service $SERVICE_NAME not found or invalid state: $IS_ENABLED"
        exit 1
        ;;
esac