#!/bin/bash

# Detect if the install media is running or not
if [ ! -d /tmp/frzr_root ]; then
  SUBVOL=""
  MOUNT_PATH="/frzr_root"
fi

# Define the bootloader entry file
if [ -f "${MOUNT_PATH}/boot/loader/entries/frzr.conf" ]; then
	entry_file="${MOUNT_PATH}/boot/loader/entries/frzr.conf"
	options="options"
	bootloader="systemd"
elif [ -f "${MOUNT_PATH}/etc/default/grub" ]; then
	entry_file="${MOUNT_PATH}/etc/default/grub"
	options="GRUB_CMDLINE_LINUX_DEFAULT="
	bootloader="grub"
else
	echo "No supported bootloader configuration file found."
	exit 0
fi

# Define usage function
function usage() {
    echo "Usage: $0 [--append STRING_TO_APPEND | --remove STRING_TO_REMOVE | --list]"
}

# Check if the script was called with an option
if [[ $# -eq 0 ]]; then
    usage
    exit 1
fi

# Check which option was specified
case "$1" in
    --append)
        # Define the string to append
        search_string="$2"

        # Extract the key if it's a key=value format
        if [[ "$search_string" == *"="* ]]; then
            param_key="${search_string%%=*}"
            
            # Get current kernel parameters
            if [ "$bootloader" = "systemd" ]; then
                current_params=$(grep "^$options" "$entry_file" | sed "s/^$options //")
            elif [ "$bootloader" = "grub" ]; then
                current_params=$(grep "^$options" "$entry_file" | sed 's/^[^"]*"\([^"]*\)".*/\1/')
            fi

            # Check if the parameter with the same key already exists
            if echo "$current_params" | grep -q "\b${param_key}="; then
                # Extract the current value of this parameter
                current_value=$(echo "$current_params" | grep -o "\b${param_key}=[^ ]*" | cut -d'=' -f2)
                new_value="${search_string#*=}"
                
                # Check if the values are the same
                if [ "$current_value" = "$new_value" ]; then
                    echo "Parameter '$param_key' already exists with the same value ($new_value) in $entry_file"
                    echo "No changes needed"
                    exit 0
                fi
                
                echo "Parameter with key '$param_key' already exists in $entry_file"
                echo "Updating parameter value from '$current_value' to '$new_value'"
                
                # Replace the existing parameter with the new one
                if [ "$bootloader" = "systemd" ]; then
                    sed -i "s~\b${param_key}=[^ ]*~${search_string}~g" "$entry_file"
                elif [ "$bootloader" = "grub" ]; then
                    sed -i "s~\b${param_key}=[^ ]*~${search_string}~g" "$entry_file"
                fi
                
                echo "Updated parameter '$param_key' with new value in $entry_file"
                exit 0
            fi
        fi

        # If not a key=value format or key doesn't exist, proceed with the original logic
        if grep -qF "$search_string" "$entry_file"; then
            echo "The string '$search_string' is already present in $entry_file"
        else
            # If the string is not present, append it to the end of the kernel parameters
            echo "The string '$search_string' is not present in $entry_file"
            echo "Updating $entry_file"
            if [ "$bootloader" = "systemd" ]; then
            	sed -i "/^$options/ s~\$~ $search_string~" "$entry_file"
            elif [ "$bootloader" = "grub" ]; then
            	sed -i "s/quiet/quiet $search_string/" "$entry_file"
	    	fi
            echo "Added '$search_string' to the kernel boot parameters in $entry_file"
        fi
        ;;
    --remove)
        # Define the string to remove
        remove_string="$2"
        found_match=false

        # Get current kernel parameters
        if [ "$bootloader" = "systemd" ]; then
            current_params=$(grep "^$options" "$entry_file" | sed "s/^$options //")
        elif [ "$bootloader" = "grub" ]; then
            current_params=$(grep "^$options" "$entry_file" | sed 's/^[^"]*"\([^"]*\)".*/\1/')
        fi

        # First check if this is a key only (without =value part)
        if [[ "$remove_string" != *"="* ]]; then
            # Check if any parameter with this key exists
            if echo "$current_params" | grep -q "\(^\| \)${remove_string}="; then
                # Remove the parameter with this key
                if [ "$bootloader" = "systemd" ]; then
                    sed -i "s~ ${remove_string}=[^ ]*~~g" "$entry_file"
                elif [ "$bootloader" = "grub" ]; then
                    sed -i "s~ ${remove_string}=[^ ]*~~g" "$entry_file"
                fi
                
                echo "Removed parameter with key '$remove_string' from $entry_file"
                found_match=true
                exit 0
            fi
        fi

        # If not a key-only format or key doesn't exist, proceed with the original logic
        # First get all kernel parameters as separate words
        if [ "$bootloader" = "systemd" ]; then
            param_list=$(grep "^$options" "$entry_file" | sed "s/^$options //" | tr ' ' '\n')
        elif [ "$bootloader" = "grub" ]; then
            param_list=$(grep "^$options" "$entry_file" | sed 's/^[^"]*"\([^"]*\)".*/\1/' | tr ' ' '\n')
        fi
        
        # Check if the exact parameter exists as a whole word
        if echo "$param_list" | grep -qx "$remove_string"; then
            # Remove only if it's a whole parameter (followed by space or end of line)
            if [ "$bootloader" = "systemd" ]; then
                sed -i "s~ $remove_string\( \|$\)~ ~g" "$entry_file"
            elif [ "$bootloader" = "grub" ]; then
                sed -i "s~ $remove_string\( \|$\)~ ~g" "$entry_file"
            fi
            echo "Removed '$remove_string' from the kernel parameters in $entry_file"
            found_match=true
        fi
        
        # If no match was found in any of the checks, display a message
        if [ "$found_match" = false ]; then
            if [[ "$remove_string" != *"="* ]]; then
                echo "No parameter with key '$remove_string' found in $entry_file"
            else
                echo "Parameter '$remove_string' not found in $entry_file"
            fi
        fi
        ;;
    --list)
        # Print the current kernel parameters
        echo "Current kernel parameters:"
        grep "^$options" "$entry_file" | sed 's/^"'$options'" //' | sed 's/\s*$//' | tr ' ' '\n'
        ;;
    *)
        usage
        exit 1
        ;;
esac
