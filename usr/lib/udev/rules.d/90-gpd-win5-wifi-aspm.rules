# Disable PCIe ASPM for Intel AX210 WiFi on GPD Win5
# Fix for Queue stuck + 0x5A5A5A5A firmware crashes under high load
# Root cause: PCIe ASPM L1 power saving causes bus communication timeout
# Note: This is GPD Win5 specific - other devices with AX210 may not need this

# Disable ASPM for Intel AX210 on GPD Win5
SUBSYSTEM=="pci", ATTR{vendor}=="0x8086", ATTR{device}=="0x2725", DRIVER=="iwlwifi", PROGRAM=="/usr/bin/sh -c 'test $(cat /sys/class/dmi/id/product_name) = G1618-05'", RUN+="/usr/bin/setpci -s $kernel CAP_EXP+10.w=0x0040"

